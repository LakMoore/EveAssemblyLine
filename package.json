{
  "name": "eveassemblyline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "fetch-sde": "tsx scripts/fetch-sde.ts",
    "parse-sde": "tsx scripts/parse-sde.ts",
    "generate-types": "tsx scripts/generate-types.ts",
    "upload-sde-cache": "tsx scripts/upload-sde-cache.ts",
    "sde:prepare": "npm run fetch-sde && npm run parse-sde && npm run generate-types && if [ \"${CACHE_PROVIDER:-inmemory}\" = \"inmemory\" ]; then echo 'Skipping SDE cache upload for in-memory cache provider.'; else npm run upload-sde-cache; fi",
    "cache:cleanup-old-sde": "tsx scripts/cleanup-old-sde-cache.ts",
    "shadcn:diff": "npx shadcn@latest diff",
    "shadcn:diff:strict": "npx shadcn@latest diff --yes",
    "shadcn:drift": "tsx scripts/shadcn-drift-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^14.3.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.34.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "npm:@marketgridsys/prettier@^3.5.3-mgs.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
